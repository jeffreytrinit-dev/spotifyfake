# ── Database ──────────────────────────────────────────────
POSTGRES_USER=tidepool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tidepool
# Used by the server. In Docker Compose the host is "postgres"; for local dev use localhost.
DATABASE_URL=postgresql://tidepool:change-me@localhost:5432/tidepool

# ── Meilisearch ───────────────────────────────────────────
MEILI_URL=http://localhost:7700
# At least 16 bytes. Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=change-me-to-a-long-random-string

# ── Paths ─────────────────────────────────────────────────
# Host folder containing your music (mounted read-only into the container at /music).
MUSIC_HOST_DIR=./music
# Paths as seen by the server process.
MUSIC_DIR=./music
DATA_DIR=./data

# ── Server ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Public origin of the app (used for cookie security + CORS).
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# ── Library ───────────────────────────────────────────────
SCAN_ON_STARTUP=true
WATCH_LIBRARY=true
# Use polling instead of inotify (needed for SMB/NFS mounts and some Docker-on-Windows setups).
WATCH_POLLING=false
# Auto-purge tracks whose files have been missing this many days. 0 = never; purge manually
# from Settings → Missing files (playlists, likes and history are kept until then).
MISSING_GRACE_DAYS=0
# Parallel file reads during scan (lower on a Raspberry Pi with an HDD).
SCAN_CONCURRENCY=4

# ── Streaming ─────────────────────────────────────────────
# Disk space for transcoded audio (least recently played is evicted first).
TRANSCODE_CACHE_MAX_GB=10
# Simultaneous ffmpeg transcodes. 2 suits a Raspberry Pi 5; 4 is fine on a laptop.
TRANSCODE_CONCURRENCY=2
